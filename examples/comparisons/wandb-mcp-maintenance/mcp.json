{
  "mcpServers": {
    "wandb-0-3-7": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/wandb/wandb-mcp-server@80252b3aa23ae3c1fdde089ce2b7dfb106dafb38",
        "wandb_mcp_server"
      ],
      "env": {
        "WANDB_API_KEY": "${WANDB_API_KEY}",
        "WANDB_BASE_URL": "${WANDB_BASE_URL}"
      },
      "allowed_hosts": [
        "api.wandb.test",
        "app.wandb.test",
        "trace.wandb.test"
      ],
      "version": "git:80252b3aa23ae3c1fdde089ce2b7dfb106dafb38"
    },
