{
  "mcpServers": {
    "wandb-main": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/wandb/wandb-mcp-server@53b199a5f4af29aa82077e2c7f1e2c5e5e0c2ca0",
        "wandb_mcp_server"
      ],
      "env": {
        "WANDB_API_KEY": "${WANDB_API_KEY}",
        "WANDB_BASE_URL": "https://api.wandb.ai",
        "MCP_ANALYTICS_LOG_STREAM": "stderr"
      },
      "allowed_hosts": [
        "api.wandb.ai",
        "app.wandb.ai",
        "trace.wandb.ai"
      ],
      "version": "git:53b199a5f4af29aa82077e2c7f1e2c5e5e0c2ca0"
    },
    "wandb-0-4-staging": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/wandb/wandb-mcp-server@3dd4447ef0054d4707aafc515e3f2ddfb11b17bd",
        "wandb_mcp_server"
      ],
      "env": {
        "WANDB_API_KEY": "${WANDB_API_KEY}",
        "WANDB_BASE_URL": "https://api.wandb.ai",
        "MCP_ANALYTICS_LOG_STREAM": "stderr"
      },
      "allowed_hosts": [
        "api.wandb.ai",
        "app.wandb.ai",
        "trace.wandb.ai"
      ],
      "version": "git:3dd4447ef0054d4707aafc515e3f2ddfb11b17bd"
    }
  }
}
