{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ash0ts/fugue/blob/main/examples/comparisons/superpowers-writing-plans-upgrade/conference-sampling-frame-v1.schema.json",
  "title": "Superpowers writing-plans powered sampling frame V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "frame_digest",
    "reserved_studies",
    "skill_treatment",
    "population_snapshot",
    "selection_protocol",
    "public_tasks",
    "private_labels",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "frame_id": {"const": "superpowers-writing-plans-conference-sampling-frame-v1"},
    "frame_digest": {"$ref": "#/$defs/sha256"},
    "reserved_studies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "holdout"],
      "properties": {
        "development": {"const": "superpowers-writing-plans-conference-development-v1"},
        "holdout": {"const": "superpowers-writing-plans-conference-holdout-v1"}
      }
    },
    "skill_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "lock_path",
        "lock_sha256",
        "baseline_commit",
        "baseline_bundle_sha256",
        "candidate_commit",
        "candidate_bundle_sha256"
      ],
      "properties": {
        "repository": {"const": "https://github.com/obra/superpowers"},
        "path": {"const": "skills/writing-plans"},
        "lock_path": {"$ref": "#/$defs/relativePath"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_commit": {"const": "de4672b171213a6ff6960228d8b95c46ea0b09f4"},
        "baseline_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_commit": {"const": "8e1262a3bae92b640d87fa81c51c53b65e490590"},
        "candidate_bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "population_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_cutoff_utc",
        "records_path",
        "records_sha256",
        "record_count",
        "query_receipt_path",
        "query_receipt_sha256",
        "eligibility_protocol_path",
        "eligibility_protocol_sha256",
        "selection_code_path",
        "selection_code_sha256"
      ],
      "properties": {
        "selection_cutoff_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "records_path": {"$ref": "#/$defs/relativePath"},
        "records_sha256": {"$ref": "#/$defs/sha256"},
        "record_count": {"type": "integer", "minimum": 288},
        "query_receipt_path": {"$ref": "#/$defs/relativePath"},
        "query_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_protocol_path": {"$ref": "#/$defs/relativePath"},
        "eligibility_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "selection_code_path": {"$ref": "#/$defs/relativePath"},
        "selection_code_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selection_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_sha256",
        "algorithm",
        "cluster_unit",
        "unique_clusters_across_partitions",
        "strata"
      ],
      "properties": {
        "seed_sha256": {"$ref": "#/$defs/sha256"},
        "algorithm": {"const": "sha256_seeded_sort_v1"},
        "cluster_unit": {"const": "canonical_github_repository"},
        "unique_clusters_across_partitions": {"const": true},
        "strata": {
          "const": {
            "development": {
              "security_privacy": 8,
              "identity_migration": 8,
              "lifecycle_recovery": 8,
              "integration_runtime": 8
            },
            "target_holdout": {
              "security_privacy": 48,
              "identity_migration": 48,
              "lifecycle_recovery": 48,
              "integration_runtime": 48
            },
            "safety_control": {
              "docs_only": 16,
              "unsafe_request": 16,
              "no_change_required": 16,
              "single_surface": 16
            }
          }
        }
      }
    },
    "public_tasks": {"$ref": "#/$defs/publicManifest"},
    "private_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "count", "host_only", "required_mode"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "count": {"const": 288},
        "host_only": {"const": true},
        "required_mode": {"const": "0600"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 288,
      "maxItems": 288,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000\\r\\n]+$"
    },
    "publicManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "count"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "count": {"const": 288}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "partition",
        "stratum",
        "selection_rank",
        "repository_url",
        "repository_owner",
        "repository_name",
        "commit_sha",
        "tree_sha",
        "public_record_url",
        "public_record_kind",
        "public_record_id",
        "provenance_cluster_id",
        "population_record_digest",
        "selection_score_sha256",
        "source_archive_path",
        "source_archive_sha256",
        "source_manifest_path",
        "source_manifest_sha256",
        "provenance_receipt_path",
        "provenance_receipt_sha256",
        "public_task_digest",
        "private_label_digest",
        "license"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^sp-(dev|target|control)-[a-z0-9][a-z0-9-]{2,95}$"
        },
        "partition": {"enum": ["development", "target_holdout", "safety_control"]},
        "stratum": {
          "enum": [
            "security_privacy",
            "identity_migration",
            "lifecycle_recovery",
            "integration_runtime",
            "docs_only",
            "unsafe_request",
            "no_change_required",
            "single_surface"
          ]
        },
        "selection_rank": {"type": "integer", "minimum": 1},
        "repository_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "repository_owner": {"type": "string", "minLength": 1},
        "repository_name": {"type": "string", "minLength": 1},
        "commit_sha": {"$ref": "#/$defs/gitSha"},
        "tree_sha": {"$ref": "#/$defs/gitSha"},
        "public_record_url": {
          "type": "string",
          "pattern": "^https://github\\.com/.+/(issues|pull|commit)/.+$"
        },
        "public_record_kind": {"enum": ["issue", "pull_request", "commit"]},
        "public_record_id": {"type": "string", "minLength": 1},
        "provenance_cluster_id": {
          "type": "string",
          "pattern": "^github:[a-z0-9_.-]+/[a-z0-9_.-]+$"
        },
        "population_record_digest": {"$ref": "#/$defs/sha256"},
        "selection_score_sha256": {"$ref": "#/$defs/sha256"},
        "source_archive_path": {"$ref": "#/$defs/relativePath"},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest_path": {"$ref": "#/$defs/relativePath"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_receipt_path": {"$ref": "#/$defs/relativePath"},
        "provenance_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "public_task_digest": {"$ref": "#/$defs/sha256"},
        "private_label_digest": {"$ref": "#/$defs/sha256"},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx_id", "path", "sha256"],
          "properties": {
            "spdx_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$",
              "not": {"enum": ["NONE", "NOASSERTION"]}
            },
            "path": {"$ref": "#/$defs/relativePath"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
