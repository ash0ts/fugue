{
  "$id": "https://fugue.local/schemas/provider/provider-descriptor-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "descriptor_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "display_name": {
      "minLength": 1,
      "type": "string"
    },
    "evaluator_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "input_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "lifecycle_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "protocol_version": {
      "const": 1
    },
    "provider_id": {
      "minLength": 1,
      "type": "string"
    },
    "provider_version": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_provenance": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "source_digest"
      ],
      "type": "object"
    },
    "task_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "provider_id",
    "display_name",
    "provider_version",
    "protocol_version",
    "capabilities",
    "task_types",
    "input_types",
    "evaluator_types",
    "lifecycle_types",
    "source_provenance",
    "descriptor_digest"
  ],
  "title": "provider-descriptor",
  "type": "object"
}
